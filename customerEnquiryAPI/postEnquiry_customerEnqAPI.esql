

CREATE COMPUTE MODULE postEnquiry_customerEnqAPI
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		DECLARE customerId CHARACTER;

    SET customerId = InputRoot.JSON.Data.customerId;
    
    IF customerId = '1001' THEN
    	
        SET OutputRoot.JSON.Data.status = 'SUCCESS';
        SET OutputRoot.JSON.Data.statusCode = '200';
        SET OutputRoot.JSON.Data.message = 'Customer details retrieved successfully';

        CREATE FIELD OutputRoot.JSON.Data.customer;

        SET OutputRoot.JSON.Data.customer.customerId = '1002';
        SET OutputRoot.JSON.Data.customer.customerName = 'Alice Johnson';
        SET OutputRoot.JSON.Data.customer.gender = 'Female';
        SET OutputRoot.JSON.Data.customer.dateOfBirth = '1992-08-18';
        SET OutputRoot.JSON.Data.customer.branchName = 'Abu Dhabi Branch';
        SET OutputRoot.JSON.Data.customer.accountNumber = '223456789012';
        SET OutputRoot.JSON.Data.customer.accountType = 'Current';
        SET OutputRoot.JSON.Data.customer.currency = 'AED';
        SET OutputRoot.JSON.Data.customer.availableBalance = 15200.75;
        SET OutputRoot.JSON.Data.customer.accountStatus = 'Active';
        SET OutputRoot.JSON.Data.customer.apiVersion = 'v3.0.0';
        

    ELSE

        SET OutputRoot.JSON.Data.status = 'FAILED';
        SET OutputRoot.JSON.Data.statusCode = '404';
        SET OutputRoot.JSON.Data.message = 'Customer not found';

    END IF;
		RETURN TRUE;
	END;
END MODULE;
